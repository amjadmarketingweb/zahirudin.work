---
interface Props {
  name: string;
  issuer?: string;
  year: string | number;
  featured?: boolean;
}

const { name, issuer, year, featured = false } = Astro.props;
---

<article class:list={['credential-card', { 'credential-card--featured': featured }] }>
  <span class="credential-year">{year}</span>
  <h3>{name}</h3>
  {issuer && <p>{issuer}</p>}
</article>
